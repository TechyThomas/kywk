[
  {
    "label": "PHP Docblocker: Current File",
    "command": "php-docblocker",
    "args": [
      "--file",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "PHP Docblocker: Selection",
    "command": "php-docblocker --file \"$ZED_FILE\" --selection-stdin <<'__PHP_DOCBLOCKER_SELECTION_29C9E6B4__'\n$ZED_SELECTED_TEXT\n__PHP_DOCBLOCKER_SELECTION_29C9E6B4__",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "PHP Code Review (Ollama): Current File",
    "command": "php-docblocker",
    "args": [
      "--review",
      "--file",
      "$ZED_FILE",
      "--report-dir",
      "$ZED_WORKTREE_ROOT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "PHP Code Review (Ollama): Selection",
    "command": "php-docblocker --review --file \"$ZED_FILE\" --report-dir \"$ZED_WORKTREE_ROOT\" --selection-stdin <<'__PHP_DOCBLOCKER_REVIEW_74AC19E2__'\n$ZED_SELECTED_TEXT\n__PHP_DOCBLOCKER_REVIEW_74AC19E2__",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "PHP Code Review (Ollama): Whole Project",
    "command": "php-docblocker",
    "args": [
      "--review-project",
      "--project-root",
      "$ZED_WORKTREE_ROOT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  },
  {
    "label": "PHP Code Review (Ollama): Select Directory",
    "command": "php-docblocker",
    "args": [
