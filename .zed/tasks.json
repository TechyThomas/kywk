[
  {
    "label": "PHP Docblocker: Current File",
    "command": "php-docblocker",
    "args": [
      "--file",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "PHP Docblocker: Selection",
    "command": "php-docblocker",
    "args": [
      "--file",
      "$ZED_FILE",
      "--selection",
      "$ZED_SELECTED_TEXT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
